{
  "name": "vs-avd",
  "displayName": "Android Emulator Viewer",
  "description": "View and interact with Android AVDs from inside VS Code",
  "version": "0.0.1",
  "publisher": "devloop",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:vs-avd.openEmulatorViewer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vs-avd.openEmulatorViewer",
        "title": "Open Android Emulator Viewer"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p ."
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/vscode": "^1.92.0",
    "typescript": "^5.5.4"
  }
}
