{
  "name": "vs-avd",
  "displayName": "Android Emulator Viewer",
  "description": "View and interact with Android AVDs from inside VS Code",
  "version": "1.0.3",
  "publisher": "D0Tech",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dzero1/vs-avd.git"
  },
  "bugs": {
    "url": "https://github.com/dzero1/vs-avd/issues"
  },
  "homepage": "https://github.com/dzero1/vs-avd#readme",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Debuggers",
    "Visualization"
  ],
  "keywords": [
    "android",
    "emulator",
    "avd",
    "adb",
    "scrcpy"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vs-avd.openEmulatorViewer",
        "title": "Open Android Emulator Viewer"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "vscode:package": "vsce package",
    "vscode:publish": "vsce publish",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p ."
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/vscode": "^1.92.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.5.4"
  }
}
